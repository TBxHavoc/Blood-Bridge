# Copy to .env and adjust. .env is git-ignored.
# ---------------------------------------------------------------------------
# Database URL is the single switch between PostgreSQL and Db2.
#   PostgreSQL (local Docker): postgresql+psycopg://bloodbridge:bloodbridge@localhost:5432/bloodbridge
#   Db2 on IBM Z (later):      db2+ibm_db://user:pass@host:50000/bloodbridge
# No application code changes are required to switch.
DATABASE_URL=postgresql+psycopg://bloodbridge:bloodbridge@localhost:5432/bloodbridge

DB_ECHO=false

# Secrets — override in .env, never commit real values.
# The app refuses to start with a weak/default secret when ENVIRONMENT=production.
# Generate one with:  python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=replace-with-a-64-char-random-hex-value-before-deploying-change-me
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=120

# Comma-separated list of allowed frontend origins.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Set to true only when running behind a trusted reverse proxy that sets
# X-Forwarded-For (otherwise the header is ignored to prevent spoofing).
TRUST_FORWARDED_FOR=false

# Matching / lifecycle defaults (also seeded into system_config).
HOLD_TTL_MINUTES=10
MATCH_SCORE_THRESHOLD=50
MAX_ETA_MINUTES=180

ENVIRONMENT=development

# --- Seed / bootstrap credentials -------------------------------------------
# Leave these blank in the repo and set the real values in the git-ignored
# .env. Never commit actual credentials.
#   SEED_PASSWORD  : shared password for the synthetic demo accounts created by
#                    `python -m app.seed.seed`.
#   ADMIN_USERNAME / ADMIN_PASSWORD : a temporary admin login, (re)created at
#                    startup. Changing it here rotates the account's password.
SEED_PASSWORD=
ADMIN_USERNAME=
ADMIN_PASSWORD=

# --- Dedicated demo accounts (2 hospitals, 2 blood banks) ---------------------
# Individual credentials: each organisation logs in with its own password and
# sees only its own inventory in the Inventory page (never the eRaktKosh snapshot).
# Usernames have sensible defaults; set the passwords here. Never commit real values.
DEMO_HOSPITAL_1_USERNAME=demo_hospital_1
DEMO_HOSPITAL_1_PASSWORD=
DEMO_HOSPITAL_2_USERNAME=demo_hospital_2
DEMO_HOSPITAL_2_PASSWORD=
DEMO_BANK_1_USERNAME=demo_bank_1
DEMO_BANK_1_PASSWORD=
DEMO_BANK_2_USERNAME=demo_bank_2
DEMO_BANK_2_PASSWORD=

# --- Data acquisition -------------------------------------------------------
# API key for the data.gov.in (Open Government Data) fetches, used by
#   python scripts/fetch_karnataka_hospitals.py
# Leave blank in the repo; set the real key in the git-ignored .env. Request
# one from https://data.gov.in (account menu -> API key). The running app does
# not read this -- only the fetch scripts -- and pydantic-settings ignores it.
DATAGOVIN_API_KEY=
