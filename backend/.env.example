# Copy to .env and adjust. .env is git-ignored.
# ---------------------------------------------------------------------------
# Database URL is the single switch between PostgreSQL and Db2.
#   PostgreSQL (local Docker): postgresql+psycopg://bloodbridge:bloodbridge@localhost:5432/bloodbridge
#   Db2 on IBM Z (later):      db2+ibm_db://user:pass@host:50000/bloodbridge
# No application code changes are required to switch.
DATABASE_URL=postgresql+psycopg://bloodbridge:bloodbridge@localhost:5432/bloodbridge

DB_ECHO=false

# Secrets — override in .env, never commit real values.
# The app refuses to start with a weak/default secret when ENVIRONMENT=production.
# Generate one with:  python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=replace-with-a-64-char-random-hex-value-before-deploying-change-me
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=120

# Comma-separated list of allowed frontend origins.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Set to true only when running behind a trusted reverse proxy that sets
# X-Forwarded-For (otherwise the header is ignored to prevent spoofing).
TRUST_FORWARDED_FOR=false

# Matching / lifecycle defaults (also seeded into system_config).
HOLD_TTL_MINUTES=10
MATCH_SCORE_THRESHOLD=50
MAX_ETA_MINUTES=180

ENVIRONMENT=development
SEED_PASSWORD=Password123!
