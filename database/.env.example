# Copy to .env and adjust. .env is git-ignored.
# =============================================================================
# Blood Bridge - Environment Configuration
# IBM Z Datathon 2026 - AI Secured Track (Innovation without Exposure)
# =============================================================================

# Database URL is the single switch between PostgreSQL and Db2 on IBM Z.
#   PostgreSQL (local Docker): postgresql+psycopg://bloodbridge:bloodbridge@localhost:5432/bloodbridge
#   Db2 on IBM Z (live demo):  db2+ibm_db://db2inst1:pass@linuxone.demos.ibm.com:50000/BLDPRD
# No application code changes are required to switch.
DATABASE_URL=postgresql+psycopg://bloodbridge:bloodbridge@localhost:5432/bloodbridge

DB_ECHO=false

# Secrets — override in .env, never commit real values.
JWT_SECRET_KEY=9a48d88e72c2194a37b370a256920f262846fbb2a792d470d2208e162ba7b2c0
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=720

# Comma-separated list of allowed frontend origins.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Matching / lifecycle defaults (also seeded into system_config).
HOLD_TTL_MINUTES=10
MATCH_SCORE_THRESHOLD=50
MAX_ETA_MINUTES=180

ENVIRONMENT=development
SEED_PASSWORD=Demo2026!

# --- IBM LinuxONE / IBM Z Db2 Settings (Live Demo Target) ---
DB2_HOST=linuxone.demos.ibm.com
DB2_PORT=50000
DB2_DATABASE=BLDPRD
DB2_USER=db2inst1
DB2_PASSWORD=YourLinuxOnePasswordHere
DB2_SECURITY=SSL
DATABASE_URL_DB2=ibm_db_sa://db2inst1:YourLinuxOnePasswordHere@linuxone.demos.ibm.com:50000/BLDPRD;SECURITY=SSL;
