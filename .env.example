# ---------------------------------------------------------------------------
# Backend integration
# ---------------------------------------------------------------------------
# Copy this file to `.env.local` and fill in your values.

# Base URL of the backend API. Leave empty (or unset) to run the app against
# the built-in mock API so the UI works before the server is ready.
# Examples:
#   VITE_API_BASE_URL=http://localhost:8080/api
#   VITE_API_BASE_URL=/api          # uses the Vite dev proxy (see vite.config.js)
VITE_API_BASE_URL=

# Force the in-browser mock API on/off. When VITE_API_BASE_URL is set and this
# is not "true", the app talks to the real backend.
VITE_USE_MOCK=true

# Target the Vite dev proxy forwards /api requests to (dev only).
VITE_PROXY_TARGET=http://localhost:8080
