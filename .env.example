# Blood Bridge - full-stack configuration for docker compose.
#
#   cp .env.example .env      # then fill in every blank below
#   docker compose up -d --build
#
# .env is git-ignored: never commit real credentials.
# The same file drives a Linux / IBM LinuxONE deployment - only the values here
# change, never the compose file or the images.

# --- Docker compose project name (names the containers/volume/network) ------
COMPOSE_PROJECT_NAME=bloodbridge

# --- PostgreSQL (local fallback database) -----------------------------------
POSTGRES_USER=bloodbridge
POSTGRES_PASSWORD=change-me
POSTGRES_DB=bloodbridge
DB_PORT=5432

# --- Published ports (host side) --------------------------------------------
# Change these if something else already owns the port on your machine.
API_PORT=8000
WEB_PORT=8080
PGADMIN_PORT=5050

# --- Database switch --------------------------------------------------------
# Leave blank to build the local PostgreSQL DSN from POSTGRES_* above.
# Set it to move the whole app to Db2 on IBM Z with no rebuild, e.g.:
#   DATABASE_URL=db2+ibm_db://db2inst1:password@linuxone.demos.ibm.com:50000/BLDPRD
DATABASE_URL=

# --- Secret key -------------------------------------------------------------
# Signs the auth tokens. Must be at least 32 characters when
# ENVIRONMENT=production (the app refuses to boot otherwise).
# Generate one with:  python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=

# development | production
ENVIRONMENT=development

# --- Credentials ------------------------------------------------------------
# ADMIN_* create/recreate the bootstrap login at startup.
# SEED_PASSWORD is the shared password for the synthetic demo accounts and is
# required before the seed job runs (it refuses to create empty passwords).
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
SEED_PASSWORD=

# --- CORS -------------------------------------------------------------------
# Comma-separated origins allowed to call the API directly. Only needed for the
# Vite dev server or direct API access; the web container proxies /api through
# a single origin, so it adds none of its own.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- eRaktKosh live scraper -------------------------------------------------
# The API scrapes eRaktKosh (MoHFW / C-DAC) for Bengaluru blood stock: once
# shortly after startup, then every ERAKTKOSH_SYNC_INTERVAL_SECONDS. Set
# ERAKTKOSH_AUTO_SYNC_ENABLED=false to stop the API making outbound requests.
ERAKTKOSH_AUTO_SYNC_ENABLED=true
ERAKTKOSH_SYNC_INTERVAL_SECONDS=600

# --- pgAdmin (optional, `--profile tools`) ----------------------------------
PGADMIN_EMAIL=admin@bloodbridge.sim
PGADMIN_PASSWORD=
