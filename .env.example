# Copy to .env and adjust. .env is git-ignored.
# ---------------------------------------------------------------------------
# Database URL is the single switch between PostgreSQL and Db2.
#   PostgreSQL (local Docker): postgresql+psycopg://bloodbridge:bloodbridge@localhost:5432/bloodbridge
#   Db2 on IBM Z (later):      db2+ibm_db://user:pass@host:50000/bloodbridge
# No application code changes are required to switch.
DATABASE_URL=postgresql+psycopg://bloodbridge:bloodbridge@localhost:5432/bloodbridge

DB_ECHO=false

# Secrets — override in .env, never commit real values.
JWT_SECRET_KEY=dev-only-change-me
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=720

# Comma-separated list of allowed frontend origins.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Matching / lifecycle defaults (also seeded into system_config).
HOLD_TTL_MINUTES=10
MATCH_SCORE_THRESHOLD=50
MAX_ETA_MINUTES=180

ENVIRONMENT=development
SEED_PASSWORD=Password123!
